---
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { getPosts, slugsIn } from "../../lib/posts";
import { postPath } from "../../lib/i18n";

export async function getStaticPaths() {
  const [posts, translated] = await Promise.all([getPosts("en"), slugsIn("tr")]);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, altPath: translated.has(post.id) ? postPath(post.id, "tr") : undefined },
  }));
}

const { post, altPath } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} lang="en" altPath={altPath}>
  <Content />
</Post>
