---
import { render } from "astro:content";
import Post from "../../../layouts/Post.astro";
import { getPosts, slugsIn } from "../../../lib/posts";
import { postPath } from "../../../lib/i18n";

export async function getStaticPaths() {
  const [posts, original] = await Promise.all([getPosts("tr"), slugsIn("en")]);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, altPath: original.has(post.id) ? postPath(post.id, "en") : undefined },
  }));
}

const { post, altPath } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} lang="tr" altPath={altPath}>
  <Content />
</Post>
