---
import { homePath, other, ui, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  /** The same page in the other language; falls back to that language's home. */
  altPath?: string;
}

const { lang, altPath } = Astro.props;
const target = other(lang);
const href = altPath ?? homePath(target);
const label = { en: "EN", tr: "TR" } as const;
// Order stays fixed (EN · TR) so the switch doesn't jump between pages.
---

<span class="lang-switch" role="group" aria-label={ui[lang].switchGroup}>
  {(["en", "tr"] as const).map((l) =>
    l === lang ? (
      <span class="current" aria-current="true" lang={l}>{label[l]}</span>
    ) : (
      <a href={href} hreflang={l} lang={l} data-lang={l} title={ui[lang].switchTitle}>
        {label[l]}
      </a>
    ),
  )}
</span>
